# Julia environment resolution artifacts (regenerated by Pkg)
Manifest.toml
Manifest-v*.toml
LocalPreferences.toml

# docs/ carries the Documenter build alongside working design notes that stay
# local. Track only the build files and the site source; everything else there
# -- build output, node_modules, and the note directories -- is ignored.
docs/*
!docs/src/
!docs/Project.toml
!docs/make.jl
!docs/package.json
!docs/package-lock.json

# Tutorial markdown is generated by Literate.jl from the tracked .jl sources.
docs/src/tutorials/*.md

# Standalone architecture sketch, kept local like the docs/ design notes.
/architecture.html

# Figures the tutorials save. Inside the docs build these land in docs/build/,
# but running a tutorial standalone (julia --project=docs docs/src/tutorials/x.jl)
# writes them to whatever the working directory is, usually the repo root.
/dem_igeo7.png
/seasonal_tavg.mp4

# Lazily downloaded Copernicus DEM GeoTIFFs are a persistent local cache, not
# repository data.
/bench/data/CopernicusDEM/tiles/

# macOS
.DS_Store

# NOTE: test/IGeo7/vectors/ is intentionally NOT ignored.
# Those oracle CSV/txt fixtures are read by the test suite.
